<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Cyber Hub Online Center</title>

<style>
body{
    margin:0;
    background:#061633;
    text-align:center;
    font-family:Arial,sans-serif;
}

.website{
    position:relative;
    width:100%;
    max-width:1200px;
    margin:auto;
}

.website img{
    width:100%;
    display:block;
}

.buttons{
    padding:20px 10px 30px;
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    display:inline-block;
    padding:14px 25px;
    border-radius:30px;
    color:white;
    text-decoration:none;
    font-size:17px;
    font-weight:bold;
    box-shadow:0 5px 15px rgba(0,0,0,.3);
}

.whatsapp{
    background:#25D366;
}

.instagram{
    background:linear-gradient(45deg,#f09433,#dc2743,#bc1888);
}

.call{
    background:#2854c5;
}

.btn:hover{
    transform:scale(1.05);
}

@media(max-width:600px){
    .btn{
        width:80%;
    }
}
</style>
</head>

<body>

<div class="website">

    <img src="cyber-hub-website-image.png"
         alt="Cyber Hub Online Center">

</div>

<div class="buttons">

    <a class="btn whatsapp"
       href="https://wa.me/918873301032"
       target="_blank">
       💬 WhatsApp पर संपर्क करें
    </a>

    <a class="btn call"
       href="tel:+918873301032">
       📞 Call Now
    </a>

    <a class="btn instagram"
       href="https://www.instagram.com/rdx__abhishek__08/"
       target="_blank">
       📸 Instagram पर Follow करें
    </a>

</div>

</body>
</html>
